# Used by Docker Compose. Keep the real values in the ignored root .env file.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=enterprise-rag
PINECONE_NAMESPACE=enterprise-rag
PINECONE_EMBEDDING_MODEL=multilingual-e5-large
PINECONE_EMBEDDING_DIMENSIONS=1024

# Optional: enables generated chat answers.
GROQ_API_KEY=
