ENVIRONMENT=development
APP_NAME=Enterprise RAG
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=false

MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=enterprise_rag
PINECONE_API_KEY=
PINECONE_INDEX_NAME=enterprise-rag
PINECONE_NAMESPACE=enterprise-rag
PINECONE_EMBEDDING_MODEL=multilingual-e5-large
PINECONE_EMBEDDING_DIMENSIONS=1024

GROQ_API_KEY=

CORS_ORIGINS=http://localhost:5173
CHAT_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_HOUR=30

MAX_UPLOAD_MB=20
MODEL_CACHE_DIR=
CHUNK_MAX_WORDS=180
CHUNK_OVERLAP_WORDS=30
EMBEDDED_WORKER=false
WORKER_POLL_SECONDS=2.0
WORKER_MAX_ATTEMPTS=3
WORKER_STALE_AFTER_SECONDS=600
WARM_MODELS_ON_STARTUP=true

RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVAL_DENSE_CANDIDATES=30
RETRIEVAL_LEXICAL_CANDIDATES=30
RETRIEVAL_RERANK_CANDIDATES=12
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_RELEVANCE=0.00005
RETRIEVAL_RRF_K=60

ANSWER_MODEL=openai/gpt-oss-120b
REWRITE_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2
CITATION_MIN_COVERAGE=0.8
CHAT_HISTORY_MESSAGES=6
CHAT_MAX_QUESTION_CHARS=2000
